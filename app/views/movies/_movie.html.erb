<div id="<%= dom_id movie %>">
  <dl class="movie-facts">
    <div class="movie-fact">
      <dt>Rating</dt>
      <dd><%= movie.rating.presence || "Not specified" %></dd>
    </div>
    <div class="movie-fact">
      <dt>Release date</dt>
      <dd><%= movie.release_date || "Not specified" %></dd>
    </div>
    <div class="movie-fact movie-fact-description">
      <dt>Description</dt>
      <dd><%= movie.description.presence || "No description available." %></dd>
    </div>
  </dl>
</div>
