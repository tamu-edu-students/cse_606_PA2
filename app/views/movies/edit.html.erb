<% content_for :title, "Editing movie" %>

<main class="page-shell">
  <header class="page-heading">
    <p class="eyebrow">Update the collection</p>
    <h1>Editing movie</h1>
    <p class="page-intro">Make changes to this film's details.</p>
  </header>

  <section class="panel form-panel">
    <%= render "form", movie: @movie %>
  </section>

  <nav class="page-navigation" aria-label="Movie navigation">
    <%= link_to "View movie", @movie %>
    <%= link_to "← Back to movies", movies_path %>
  </nav>
</main>
